<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xml:base="http://example.org/ontology/ecom-retail-analytics/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://example.org/ontology/ecom-retail-analytics/"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:dcterms="http://purl.org/dc/terms/">

    <!-- ============================================================
         ONTOLOGY HEADER
         ============================================================ -->

    <owl:Ontology rdf:about="http://example.org/ontology/ecom-retail-analytics/">
        <owl:versionIRI rdf:resource="http://example.org/ontology/ecom-retail-analytics/1.0/"/>
        <owl:versionInfo>1.0</owl:versionInfo>
        <rdfs:label>Ecom Retail Analytics</rdfs:label>
        <rdfs:comment>Comprehensive semantic model for e-commerce retail analytics derived from the ecom_bronze schema. This model supports analytical queries across customers, orders, payments, order items, products, and shipments. The model enables revenue analysis, customer behavior analysis, product performance analysis, fulfillment analysis, and payment processing analysis. The model is designed to support business intelligence queries while preventing common analytical errors such as double-counting and grain mismatches.</rdfs:comment>
        <dcterms:source>test-06.yaml</dcterms:source>
        <ont:sourceFormat>OSI Semantic Model</ont:sourceFormat>
    </owl:Ontology>


        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount of discounts applied to the order. This is an order-level aggregate measure.</rdfs:comment>
        <ont:propertyType>decimal</ont:propertyType>

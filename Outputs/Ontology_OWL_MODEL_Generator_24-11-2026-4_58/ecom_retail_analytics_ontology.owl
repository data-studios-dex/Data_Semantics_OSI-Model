        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Channel through which the order was placed, such as online store or marketplace.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_shipCity">
        <rdfs:label>shipCity</rdfs:label>
        <skos:prefLabel>Ship City</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>City component of the shipping address for the order.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_shipState">
        <rdfs:label>shipState</rdfs:label>
        <skos:prefLabel>Ship State</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>State or province component of the shipping address for the order.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_shipPostalCode">
        <rdfs:label>shipPostalCode</rdfs:label>
        <skos:prefLabel>Ship Postal Code</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Postal or ZIP code component of the shipping address for the order.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_subtotal">
        <rdfs:label>subtotal</rdfs:label>
        <skos:prefLabel>Subtotal</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount representing the order total before discounts and taxes. This is an order-level aggregate measure.</rdfs:comment>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_discountAmount">
        <rdfs:label>discountAmount</rdfs:label>
        <skos:prefLabel>Discount Amount</skos:prefLabel>

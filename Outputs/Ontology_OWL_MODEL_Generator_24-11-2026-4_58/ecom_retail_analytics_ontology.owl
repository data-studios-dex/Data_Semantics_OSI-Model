    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_orderId">
        <rdfs:label>orderId</rdfs:label>
        <skos:prefLabel>Order Identifier</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Unique identifier for a customer order.</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_orderNumber">
        <rdfs:label>orderNumber</rdfs:label>
        <skos:prefLabel>Order Number</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Business-facing order reference number assigned to the transaction.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_customerId">
        <rdfs:label>customerId</rdfs:label>
        <skos:prefLabel>Customer Reference</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>References the related customer record who placed the order.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_orderDate">
        <rdfs:label>orderDate</rdfs:label>
        <skos:prefLabel>Order Date</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp when the order was placed.</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_orderStatus">
        <rdfs:label>orderStatus</rdfs:label>
        <skos:prefLabel>Order Status</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the current processing status of the order.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_salesChannel">
        <rdfs:label>salesChannel</rdfs:label>

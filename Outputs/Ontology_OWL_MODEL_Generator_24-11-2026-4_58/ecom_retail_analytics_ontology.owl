        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/payment_paymentStatus">
        <rdfs:label>paymentStatus</rdfs:label>
        <skos:prefLabel>Payment Status</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the current processing status of the payment.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/payment_amount">
        <rdfs:label>amount</rdfs:label>
        <skos:prefLabel>Amount</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount processed in the payment.</rdfs:comment>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/payment_currency">
        <rdfs:label>currency</rdfs:label>
        <skos:prefLabel>Currency</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Currency code in which the payment amount is recorded.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/payment_transactionRef">
        <rdfs:label>transactionRef</rdfs:label>
        <skos:prefLabel>Transaction Reference</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Reference code provided by the payment gateway for the transaction.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/payment_gateway">
        <rdfs:label>gateway</rdfs:label>
        <skos:prefLabel>Gateway</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of the payment gateway or processor handling the transaction.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/payment_paidAt">
        <rdfs:label>paidAt</rdfs:label>
        <skos:prefLabel>Paid At</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp when the payment was completed or captured.</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- ============================================================
         DATA PROPERTIES — Shipment
         ============================================================ -->

    <!-- Shipment properties -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/shipment_shipmentId">
        <rdfs:label>shipmentId</rdfs:label>
        <skos:prefLabel>Shipment Identifier</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Unique identifier for a shipment.</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/shipment_orderId">
        <rdfs:label>orderId</rdfs:label>
        <skos:prefLabel>Order Reference</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>References the related order associated with the shipment.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/shipment_carrier">
        <rdfs:label>carrier</rdfs:label>

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>

    <!-- ============================================================
         ENTITY TYPES (CLASSES)
         ============================================================ -->

    <owl:Class rdf:about="http://example.org/ontology/ecom-retail-analytics/Customer">
        <rdfs:label>Customer</rdfs:label>
        <skos:prefLabel>Customers</skos:prefLabel>
        <rdfs:comment>A registered individual who places orders and whose demographic, contact, address, and segmentation attributes are tracked for customer-level analysis.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/ecom-retail-analytics/"/>
        <ont:icon>👤</ont:icon>
        <ont:iconCode>U+1F464</ont:iconCode>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/ecom-retail-analytics/Order">
        <rdfs:label>Order</rdfs:label>
        <skos:prefLabel>Orders</skos:prefLabel>
        <rdfs:comment>A commercial transaction placed by a customer, capturing order timing, status, sales channel, shipping address, and pre-calculated order-level financial totals.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/ecom-retail-analytics/"/>
        <ont:icon>🧾</ont:icon>
        <ont:iconCode>U+1F9FE</ont:iconCode>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/ecom-retail-analytics/OrderItem">
        <rdfs:label>OrderItem</rdfs:label>
        <skos:prefLabel>Order Items</skos:prefLabel>
        <rdfs:comment>A single line item within an order, linking a product to its ordered quantity, unit price, discount percentage, and computed line total for product-level revenue analysis.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/ecom-retail-analytics/"/>
        <ont:icon>🛒</ont:icon>
        <ont:iconCode>U+1F6D2</ont:iconCode>
        <ont:color>#00B7C3</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/ecom-retail-analytics/Product">
        <rdfs:label>Product</rdfs:label>
        <skos:prefLabel>Products</skos:prefLabel>
        <rdfs:comment>An item in the product catalog described by its SKU, name, category, brand, pricing, inventory quantity, and active status.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/ecom-retail-analytics/"/>
        <ont:icon>📦</ont:icon>
        <ont:iconCode>U+1F4E6</ont:iconCode>
        <ont:color>#5C2D91</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/ecom-retail-analytics/Payment">
        <rdfs:label>Payment</rdfs:label>
        <skos:prefLabel>Payments</skos:prefLabel>
        <rdfs:comment>A payment transaction associated with an order, recording the payment method, status, amount, currency, gateway, and the timestamp when payment was captured.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/ecom-retail-analytics/"/>
        <ont:icon>💳</ont:icon>
        <ont:iconCode>U+1F4B3</ont:iconCode>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/ecom-retail-analytics/Shipment">
        <rdfs:label>Shipment</rdfs:label>
        <skos:prefLabel>Shipments</skos:prefLabel>
        <rdfs:comment>A fulfillment shipment linked to an order, capturing carrier details, tracking number, shipment status, dispatch and delivery timestamps, and destination address.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/ecom-retail-analytics/"/>
        <ont:icon>🚚</ont:icon>
        <ont:iconCode>U+1F69A</ont:iconCode>
        <ont:color>#D83B01</ont:color>
    </owl:Class>


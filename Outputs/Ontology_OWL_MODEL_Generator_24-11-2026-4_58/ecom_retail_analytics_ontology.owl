        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/shipment_trackingNumber">
        <rdfs:label>trackingNumber</rdfs:label>
        <skos:prefLabel>Tracking Number</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Tracking code assigned by the carrier to follow the shipment.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/shipment_shipmentStatus">
        <rdfs:label>shipmentStatus</rdfs:label>
        <skos:prefLabel>Shipment Status</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the current status of the shipment.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/shipment_shippedAt">
        <rdfs:label>shippedAt</rdfs:label>
        <skos:prefLabel>Shipped At</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp when the shipment left the fulfillment location.</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/shipment_deliveredAt">
        <rdfs:label>deliveredAt</rdfs:label>
        <skos:prefLabel>Delivered At</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>

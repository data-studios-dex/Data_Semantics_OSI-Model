    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_taxAmount">
        <rdfs:label>taxAmount</rdfs:label>
        <skos:prefLabel>Tax Amount</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount of taxes applied to the order. This is an order-level aggregate measure.</rdfs:comment>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_shippingFee">
        <rdfs:label>shippingFee</rdfs:label>
        <skos:prefLabel>Shipping Fee</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount charged for shipping the order. This is an order-level aggregate measure.</rdfs:comment>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_totalAmount">
        <rdfs:label>totalAmount</rdfs:label>
        <skos:prefLabel>Total Amount</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Final monetary amount charged for the order including discounts, taxes, and fees. This is an order-level aggregate measure. Formula: subtotal - discount_amount + tax_amount + shipping_fee.</rdfs:comment>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_currency">
        <rdfs:label>currency</rdfs:label>
        <skos:prefLabel>Currency</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Currency code in which the order amounts are recorded.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- ============================================================
         DATA PROPERTIES — OrderItem
         ============================================================ -->

    <!-- OrderItem properties -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/orderItem_orderItemId">
        <rdfs:label>orderItemId</rdfs:label>
        <skos:prefLabel>Order Item Identifier</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Unique identifier for an order line item.</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/orderItem_orderId">
        <rdfs:label>orderId</rdfs:label>
        <skos:prefLabel>Order Reference</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>References the related order to which the line item belongs.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/orderItem_lineNumber">
        <rdfs:label>lineNumber</rdfs:label>
        <skos:prefLabel>Line Number</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Sequential line number of the item within the order.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/orderItem_productId">
        <rdfs:label>productId</rdfs:label>
        <skos:prefLabel>Product Reference</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>References the related product included in the order line item.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/orderItem_quantity">
        <rdfs:label>quantity</rdfs:label>
        <skos:prefLabel>Quantity</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Number of product units ordered for the line item.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/orderItem_unitPrice">
        <rdfs:label>unitPrice</rdfs:label>
        <skos:prefLabel>Unit Price</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary price per unit of the product at the time of ordering.</rdfs:comment>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/orderItem_discountPct">
        <rdfs:label>discountPct</rdfs:label>
        <skos:prefLabel>Discount Percentage</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Percentage discount applied to the line item.</rdfs:comment>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/orderItem_lineTotal">
        <rdfs:label>lineTotal</rdfs:label>
        <skos:prefLabel>Line Total</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary total for the line item after discounts. This is a line-level measure that can be aggregated for product-level revenue analysis. Formula: quantity * unit_price * (1 - discount_pct / 100).</rdfs:comment>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- ============================================================
         DATA PROPERTIES — Product
         ============================================================ -->

    <!-- Product properties -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/product_productId">
        <rdfs:label>productId</rdfs:label>
        <skos:prefLabel>Product Identifier</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>

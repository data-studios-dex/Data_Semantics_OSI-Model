        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/shipment_shipCity">
        <rdfs:label>shipCity</rdfs:label>
        <skos:prefLabel>Ship City</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>City component of the destination shipping address.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/shipment_shipState">
        <rdfs:label>shipState</rdfs:label>
        <skos:prefLabel>Ship State</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>State or province component of the destination shipping address.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/shipment_shipPostalCode">
        <rdfs:label>shipPostalCode</rdfs:label>
        <skos:prefLabel>Ship Postal Code</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Postal or ZIP code component of the destination shipping address.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- ============================================================
         OBJECT PROPERTIES (RELATIONSHIPS)
         ============================================================ -->

    <!-- Relationship: orders_to_customers — Order -> Customer -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_placed_by_customer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>placedBy</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/ecom-retail-analytics/Customer"/>
        <rdfs:comment>An order is placed by exactly one customer.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/ecom-retail-analytics/customer_places_order"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>customer</ont:toEntityId>
        <ont:joinKey>customer_id=customer_id</ont:joinKey>
        <ont:sourceRelationship>orders_to_customers</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/customer_places_order">
        <rdfs:label>places</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Customer"/>
        <rdfs:range rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:comment>A customer places one or more orders.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/ecom-retail-analytics/order_placed_by_customer"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>customer</ont:fromEntityId>
        <ont:toEntityId>order</ont:toEntityId>
        <ont:joinKey>customer_id=customer_id</ont:joinKey>
        <ont:sourceRelationship>orders_to_customers</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- Relationship: order_items_to_orders — OrderItem -> Order -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/orderItem_belongs_to_order">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>belongsTo</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/OrderItem"/>
        <rdfs:range rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:comment>An order item belongs to exactly one order.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/ecom-retail-analytics/order_contains_orderItem"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>orderItem</ont:fromEntityId>
        <ont:toEntityId>order</ont:toEntityId>
        <ont:joinKey>order_id=order_id</ont:joinKey>
        <ont:sourceRelationship>order_items_to_orders</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_contains_orderItem">
        <rdfs:label>contains</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/ecom-retail-analytics/OrderItem"/>
        <rdfs:comment>An order contains one or more order items.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/ecom-retail-analytics/orderItem_belongs_to_order"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>orderItem</ont:toEntityId>
        <ont:joinKey>order_id=order_id</ont:joinKey>
        <ont:sourceRelationship>order_items_to_orders</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- Relationship: order_items_to_products — OrderItem -> Product -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/orderItem_refers_to_product">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>refersTo</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/OrderItem"/>
        <rdfs:range rdf:resource="http://example.org/ontology/ecom-retail-analytics/Product"/>
        <rdfs:comment>An order item refers to exactly one product.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/ecom-retail-analytics/product_appears_in_orderItem"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>orderItem</ont:fromEntityId>
        <ont:toEntityId>product</ont:toEntityId>
        <ont:joinKey>product_id=product_id</ont:joinKey>
        <ont:sourceRelationship>order_items_to_products</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/product_appears_in_orderItem">
        <rdfs:label>appearsIn</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Product"/>
        <rdfs:range rdf:resource="http://example.org/ontology/ecom-retail-analytics/OrderItem"/>
        <rdfs:comment>A product appears in one or more order items.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/ecom-retail-analytics/orderItem_refers_to_product"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>product</ont:fromEntityId>
        <ont:toEntityId>orderItem</ont:toEntityId>
        <ont:joinKey>product_id=product_id</ont:joinKey>
        <ont:sourceRelationship>order_items_to_products</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- Relationship: payments_to_orders — Payment -> Order -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/payment_settles_order">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>settles</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Payment"/>
        <rdfs:range rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:comment>A payment transaction settles exactly one order.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/ecom-retail-analytics/order_paid_by_payment"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>payment</ont:fromEntityId>
        <ont:toEntityId>order</ont:toEntityId>
        <ont:joinKey>order_id=order_id</ont:joinKey>
        <ont:sourceRelationship>payments_to_orders</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_paid_by_payment">
        <rdfs:label>paidBy</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/ecom-retail-analytics/Payment"/>
        <rdfs:comment>An order is paid by one or more payment transactions.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/ecom-retail-analytics/payment_settles_order"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>payment</ont:toEntityId>
        <ont:joinKey>order_id=order_id</ont:joinKey>
        <ont:sourceRelationship>payments_to_orders</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- Relationship: shipments_to_orders — Shipment -> Order -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/shipment_delivers_order">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>delivers</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Shipment"/>
        <rdfs:range rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:comment>A shipment delivers exactly one order.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/ecom-retail-analytics/order_fulfilled_by_shipment"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>shipment</ont:fromEntityId>
        <ont:toEntityId>order</ont:toEntityId>
        <ont:joinKey>order_id=order_id</ont:joinKey>
        <ont:sourceRelationship>shipments_to_orders</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/ecom-retail-analytics/order_fulfilled_by_shipment">
        <rdfs:label>fulfilledBy</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/ecom-retail-analytics/Shipment"/>
        <rdfs:comment>An order is fulfilled by one or more shipments.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/ecom-retail-analytics/shipment_delivers_order"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>shipment</ont:toEntityId>
        <ont:joinKey>order_id=order_id</ont:joinKey>
        <ont:sourceRelationship>shipments_to_orders</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- ============================================================
         DATA BINDINGS
         ============================================================ -->

    <ont:DataBinding rdf:about="http://example.org/ontology/ecom-retail-analytics/binding_customer">
        <ont:boundClass rdf:resource="http://example.org/ontology/ecom-retail-analytics/Customer"/>
        <ont:boundEntityId>customer</ont:boundEntityId>
        <ont:source>Databricks</ont:source>
        <ont:table>ecom_bronze.customers</ont:table>
        <ont:columnMapping>customerId=customer_id</ont:columnMapping>
        <ont:columnMapping>customerCode=customer_code</ont:columnMapping>
        <ont:columnMapping>firstName=first_name</ont:columnMapping>
        <ont:columnMapping>lastName=last_name</ont:columnMapping>
        <ont:columnMapping>email=email</ont:columnMapping>
        <ont:columnMapping>phone=phone</ont:columnMapping>
        <ont:columnMapping>gender=gender</ont:columnMapping>
        <ont:columnMapping>dateOfBirth=date_of_birth</ont:columnMapping>
        <ont:columnMapping>city=city</ont:columnMapping>
        <ont:columnMapping>state=state</ont:columnMapping>
        <ont:columnMapping>country=country</ont:columnMapping>
        <ont:columnMapping>postalCode=postal_code</ont:columnMapping>
        <ont:columnMapping>customerSegment=customer_segment</ont:columnMapping>
        <ont:columnMapping>registrationDate=registration_date</ont:columnMapping>
        <ont:columnMapping>isActive=is_active</ont:columnMapping>
    </ont:DataBinding>

    <ont:DataBinding rdf:about="http://example.org/ontology/ecom-retail-analytics/binding_order">
        <ont:boundClass rdf:resource="http://example.org/ontology/ecom-retail-analytics/Order"/>
        <ont:boundEntityId>order</ont:boundEntityId>
        <ont:source>Databricks</ont:source>
        <ont:table>ecom_bronze.orders</ont:table>
        <ont:columnMapping>orderId=order_id</ont:columnMapping>
        <ont:columnMapping>orderNumber=order_number</ont:columnMapping>
        <ont:columnMapping>customerId=customer_id</ont:columnMapping>
        <ont:columnMapping>orderDate=order_date</ont:columnMapping>
        <ont:columnMapping>orderStatus=order_status</ont:columnMapping>
        <ont:columnMapping>salesChannel=sales_channel</ont:columnMapping>
        <ont:columnMapping>shipCity=ship_city</ont:columnMapping>
        <ont:columnMapping>shipState=ship_state</ont:columnMapping>
        <ont:columnMapping>shipPostalCode=ship_postal_code</ont:columnMapping>
        <ont:columnMapping>subtotal=subtotal</ont:columnMapping>
        <ont:columnMapping>discountAmount=discount_amount</ont:columnMapping>
        <ont:columnMapping>taxAmount=tax_amount</ont:columnMapping>
        <ont:columnMapping>shippingFee=shipping_fee</ont:columnMapping>
        <ont:columnMapping>totalAmount=total_amount</ont:columnMapping>
        <ont:columnMapping>currency=currency</ont:columnMapping>
    </ont:DataBinding>

    <ont:DataBinding rdf:about="http://example.org/ontology/ecom-retail-analytics/binding_orderItem">
        <ont:boundClass rdf:resource="http://example.org/ontology/ecom-retail-analytics/OrderItem"/>
        <ont:boundEntityId>orderItem</ont:boundEntityId>
        <ont:source>Databricks</ont:source>
        <ont:table>ecom_bronze.order_items</ont:table>
        <ont:columnMapping>orderItemId=order_item_id</ont:columnMapping>
        <ont:columnMapping>orderId=order_id</ont:columnMapping>
        <ont:columnMapping>lineNumber=line_number</ont:columnMapping>
        <ont:columnMapping>productId=product_id</ont:columnMapping>
        <ont:columnMapping>quantity=quantity</ont:columnMapping>
        <ont:columnMapping>unitPrice=unit_price</ont:columnMapping>
        <ont:columnMapping>discountPct=discount_pct</ont:columnMapping>
        <ont:columnMapping>lineTotal=line_total</ont:columnMapping>
    </ont:DataBinding>

    <ont:DataBinding rdf:about="http://example.org/ontology/ecom-retail-analytics/binding_product">
        <ont:boundClass rdf:resource="http://example.org/ontology/ecom-retail-analytics/Product"/>
        <ont:boundEntityId>product</ont:boundEntityId>
        <ont:source>Databricks</ont:source>
        <ont:table>ecom_bronze.products</ont:table>
        <ont:columnMapping>productId=product_id</ont:columnMapping>
        <ont:columnMapping>sku=sku</ont:columnMapping>
        <ont:columnMapping>productName=product_name</ont:columnMapping>
        <ont:columnMapping>categoryId=category_id</ont:columnMapping>
        <ont:columnMapping>brand=brand</ont:columnMapping>
        <ont:columnMapping>description=description</ont:columnMapping>
        <ont:columnMapping>unitPrice=unit_price</ont:columnMapping>
        <ont:columnMapping>costPrice=cost_price</ont:columnMapping>
        <ont:columnMapping>currency=currency</ont:columnMapping>
        <ont:columnMapping>stockQuantity=stock_quantity</ont:columnMapping>
        <ont:columnMapping>isActive=is_active</ont:columnMapping>
        <ont:columnMapping>createdAt=created_at</ont:columnMapping>
    </ont:DataBinding>

    <ont:DataBinding rdf:about="http://example.org/ontology/ecom-retail-analytics/binding_payment">
        <ont:boundClass rdf:resource="http://example.org/ontology/ecom-retail-analytics/Payment"/>
        <ont:boundEntityId>payment</ont:boundEntityId>
        <ont:source>Databricks</ont:source>
        <ont:table>ecom_bronze.payments</ont:table>
        <ont:columnMapping>paymentId=payment_id</ont:columnMapping>
        <ont:columnMapping>orderId=order_id</ont:columnMapping>
        <ont:columnMapping>paymentMethod=payment_method</ont:columnMapping>
        <ont:columnMapping>paymentStatus=payment_status</ont:columnMapping>
        <ont:columnMapping>amount=amount</ont:columnMapping>
        <ont:columnMapping>currency=currency</ont:columnMapping>
        <ont:columnMapping>transactionRef=transaction_ref</ont:columnMapping>
        <ont:columnMapping>gateway=gateway</ont:columnMapping>
        <ont:columnMapping>paidAt=paid_at</ont:columnMapping>
    </ont:DataBinding>

    <ont:DataBinding rdf:about="http://example.org/ontology/ecom-retail-analytics/binding_shipment">
        <ont:boundClass rdf:resource="http://example.org/ontology/ecom-retail-analytics/Shipment"/>
        <ont:boundEntityId>shipment</ont:boundEntityId>
        <ont:source>Databricks</ont:source>
        <ont:table>ecom_bronze.shipments</ont:table>
        <ont:columnMapping>shipmentId=shipment_id</ont:columnMapping>
        <ont:columnMapping>orderId=order_id</ont:columnMapping>
        <ont:columnMapping>carrier=carrier</ont:columnMapping>
        <ont:columnMapping>trackingNumber=tracking_number</ont:columnMapping>
        <ont:columnMapping>shipmentStatus=shipment_status</ont:columnMapping>
        <ont:columnMapping>shippedAt=shipped_at</ont:columnMapping>
        <ont:columnMapping>deliveredAt=delivered_at</ont:columnMapping>
        <ont:columnMapping>shipCity=ship_city</ont:columnMapping>
        <ont:columnMapping>shipState=ship_state</ont:columnMapping>
        <ont:columnMapping>shipPostalCode=ship_postal_code</ont:columnMapping>
    </ont:DataBinding>

</rdf:RDF>

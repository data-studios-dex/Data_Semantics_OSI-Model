    <!-- No identifier available in the input. -->
    <owl:Class rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct">
        <rdfs:label>DrugProduct</rdfs:label>
        <skos:prefLabel>Drug Product</skos:prefLabel>
        <rdfs:comment>Central entity containing comprehensive drug product information including commercial branding, generic names, active ingredients, manufacturer details, therapeutic classification, and regulatory approval tracking.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/"/>
        <ont:icon>💊</ont:icon>
        <ont:iconCode>U+1F48A</ont:iconCode>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <!-- No identifier available in the input. -->
    <owl:Class rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugDosageForm">

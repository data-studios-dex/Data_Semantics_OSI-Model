    <!-- DrugProduct properties -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_productId">
        <rdfs:label>productId</rdfs:label>
        <skos:prefLabel>Product Identifier</skos:prefLabel>

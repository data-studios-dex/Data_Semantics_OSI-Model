        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Identifier for the drug associated with this indication. Links this indication to the parent drug product and enables relationship traversal.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugIndication_indicationName">
        <rdfs:label>indicationName</rdfs:label>

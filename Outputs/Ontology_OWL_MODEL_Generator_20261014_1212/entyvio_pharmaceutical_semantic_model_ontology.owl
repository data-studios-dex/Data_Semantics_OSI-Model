        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of the medical condition or indication for which the drug is used. Identifies the approved therapeutic use case.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugIndication_indicationCategory">
        <rdfs:label>indicationCategory</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugIndication"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Category or classification of the drug indication. Groups indications by therapeutic area or disease category for analytical purposes.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugIndication_indicationDescription">

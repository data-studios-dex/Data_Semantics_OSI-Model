    <!-- ========================================
         Entity Types (Classes)
         ======================================== -->

    <owl:Class rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct">
        <rdfs:label>DrugProduct</rdfs:label>
        <rdfs:comment>Central dataset containing comprehensive drug product information including commercial branding, generic names, active ingredients, manufacturer details, therapeutic classification, molecule types, market information, product presentation, regulatory approval years, and current product status.</rdfs:comment>
        <ont:icon>💊</ont:icon>
        <ont:iconCode>U+1F48A</ont:iconCode>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugDosageForm">
        <rdfs:label>DrugDosageForm</rdfs:label>
        <rdfs:comment>Dataset containing detailed drug dosage form configurations including dosage form types, drug strength specifications, routes of administration, and packaging descriptions.</rdfs:comment>
        <ont:icon>💉</ont:icon>
        <ont:iconCode>U+1F489</ont:iconCode>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugIndication">
        <rdfs:label>DrugIndication</rdfs:label>
        <rdfs:comment>Dataset containing drug indication information including indication names, categories, detailed descriptions, and clinical evidence levels.</rdfs:comment>
        <ont:icon>🏥</ont:icon>
        <ont:iconCode>U+1F3E5</ont:iconCode>
        <ont:color>#00B7C3</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugSafetyInformation">
        <rdfs:label>DrugSafetyInformation</rdfs:label>
        <rdfs:comment>Dataset containing drug safety information records including safety types, safety text descriptions, severity levels, and source identifiers.</rdfs:comment>
        <ont:icon>⚠️</ont:icon>
        <ont:iconCode>U+26A0</ont:iconCode>
        <ont:color>#D83B01</ont:color>
    </owl:Class>

    <!-- ========================================
         Data Properties
         ======================================== -->

    <!-- DrugProduct properties -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_productId">
        <rdfs:label>productId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier for the drug product record. Serves as the primary business key for product identification and tracking across the pharmaceutical data ecosystem.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_drugId">
        <rdfs:label>drugId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Identifier for the underlying drug associated with the product. Links this product to related dosage forms, indications, and safety information. This field enables relationship traversal across the pharmaceutical data model.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_brandName">
        <rdfs:label>brandName</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Commercial brand name under which the drug product is marketed. Represents the trademarked product name used in marketing, prescribing, and patient communication.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_genericName">
        <rdfs:label>genericName</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Non-proprietary generic name of the drug product. Represents the standardized scientific name used in regulatory filings and clinical documentation.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_activeIngredient">
        <rdfs:label>activeIngredient</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of the active pharmaceutical ingredient in the product. Identifies the therapeutic compound responsible for the drug&apos;s pharmacological effect.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_manufacturer">
        <rdfs:label>manufacturer</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of the company that manufactures the drug product. Identifies the pharmaceutical company responsible for production, quality control, and regulatory compliance.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_therapeuticArea">
        <rdfs:label>therapeuticArea</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Medical therapeutic area targeted by the drug product. Categorizes the product by medical specialty and disease domain for therapeutic portfolio analysis.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_drugClass">
        <rdfs:label>drugClass</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Pharmacological or therapeutic class of the drug product. Classifies the product by mechanism of action and therapeutic category for pharmacological analysis.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_moleculeType">
        <rdfs:label>moleculeType</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Type of molecule, such as small molecule or biologic, for the drug product. Distinguishes between traditional chemical drugs and biological therapeutic products.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_market">
        <rdfs:label>market</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Geographic or regulatory market in which the drug product is approved or sold. Identifies the regulatory jurisdiction and commercial market for the product.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_productPresentation">
        <rdfs:label>productPresentation</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Description of how the product is presented, such as vial, prefilled syringe, or blister pack. Describes the physical packaging and delivery format.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_approvalYear">
        <rdfs:label>approvalYear</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Year in which the product received regulatory approval. Tracks the regulatory approval timeline and market entry date for the product.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_productStatus">
        <rdfs:label>productStatus</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the current regulatory or commercial status of the product. Tracks whether the product is approved, pending approval, withdrawn, or discontinued.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_sourceFile">
        <rdfs:label>sourceFile</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name or path of the source file from which the product data was ingested. Provides data lineage and traceability for audit and data quality purposes.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_ingestedAt">
        <rdfs:label>ingestedAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp recording when the product data was ingested into the system. Enables data freshness tracking and temporal analysis of data loads.</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_ingestionMethod">
        <rdfs:label>ingestionMethod</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the technical method or process used to ingest the product data. Documents the ETL process and data integration approach for operational tracking.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- DrugDosageForm properties -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugDosageForm_dosageFormId">
        <rdfs:label>dosageFormId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugDosageForm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier for the dosage form record. Serves as the primary business key for dosage form identification and tracking.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugDosageForm_drugId">
        <rdfs:label>drugId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugDosageForm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Identifier for the drug associated with this dosage form. Links this dosage form to the parent drug product and enables relationship traversal.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugDosageForm_dosageForm">
        <rdfs:label>dosageForm</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugDosageForm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Describes the physical form in which the drug is administered, such as tablet or injection. Categorizes the pharmaceutical formulation type.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugDosageForm_strength">
        <rdfs:label>strength</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugDosageForm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the concentration or strength of the drug in the dosage form. Specifies the active ingredient quantity per unit dose.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugDosageForm_routeOfAdministration">
        <rdfs:label>routeOfAdministration</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugDosageForm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Specifies the route by which the drug is administered to a patient. Identifies the delivery method such as oral, intravenous, subcutaneous, or topical.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugDosageForm_packageDescription">
        <rdfs:label>packageDescription</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugDosageForm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Text description of the packaging and presentation of the dosage form. Describes the commercial packaging configuration and unit presentation.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugDosageForm_sourceFile">
        <rdfs:label>sourceFile</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugDosageForm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name or path of the source file from which the dosage form data was ingested. Provides data lineage and traceability for audit purposes.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugDosageForm_ingestedAt">
        <rdfs:label>ingestedAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugDosageForm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp recording when the dosage form data was ingested into the system. Enables data freshness tracking and temporal analysis.</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugDosageForm_ingestionMethod">
        <rdfs:label>ingestionMethod</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugDosageForm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the technical method or process used to ingest the dosage form data. Documents the ETL process for operational tracking.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>


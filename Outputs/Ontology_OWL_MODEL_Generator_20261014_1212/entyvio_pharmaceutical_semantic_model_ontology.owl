    <!-- ========================================
         Ontology Header
         ======================================== -->

    <owl:Ontology rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/">
        <rdfs:label>Entyvio Pharmaceutical Semantic Model</rdfs:label>
        <rdfs:comment>Comprehensive semantic model for Entyvio pharmaceutical data covering drug products, dosage forms, indications, and safety information. This model enables analytical queries across drug product lifecycle, therapeutic applications, safety profiles, and regulatory compliance tracking within the healthcare domain.</rdfs:comment>
    </owl:Ontology>

    <!--
        Source: osi_semantic_model_process_322.yaml
        Warehouse: entyvio_bronze
        Classes: 4 | Data properties: 120 | Object properties: 6 | Data bindings: 4
    -->


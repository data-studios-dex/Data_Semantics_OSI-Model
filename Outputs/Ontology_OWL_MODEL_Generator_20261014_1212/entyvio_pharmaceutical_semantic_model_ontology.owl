        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugIndication_ingestedAt">
        <rdfs:label>ingestedAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugIndication"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp recording when the indication data was ingested into the system. Enables data freshness tracking and temporal analysis.</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugIndication_ingestionMethod">
        <rdfs:label>ingestionMethod</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugIndication"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the technical method or process used to ingest the indication data. Documents the ETL process for operational tracking.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- DrugSafetyInformation properties -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugSafetyInformation_safetyId">
        <rdfs:label>safetyId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugSafetyInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier for the drug safety information record. Serves as the primary business key for safety record identification and tracking.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugSafetyInformation_drugId">
        <rdfs:label>drugId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugSafetyInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Identifier for the drug associated with this safety information. Links this safety record to the parent drug product and enables relationship traversal.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugSafetyInformation_safetyType">
        <rdfs:label>safetyType</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugSafetyInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Type of safety information, such as warning, precaution, or contraindication. Categorizes the nature of the safety concern for risk classification.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugSafetyInformation_safetyText">
        <rdfs:label>safetyText</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugSafetyInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Narrative text describing the specific safety warning or precaution. Provides detailed clinical safety information for healthcare professionals and patients.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugSafetyInformation_severity">
        <rdfs:label>severity</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugSafetyInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the severity level of the safety risk. Categorizes the risk level for prioritization and risk management purposes.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugSafetyInformation_sourceId">
        <rdfs:label>sourceId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugSafetyInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Identifier for the source document or system from which the safety information was derived. Provides traceability to regulatory filings and safety databases.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugSafetyInformation_sourceFile">
        <rdfs:label>sourceFile</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugSafetyInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name or path of the source file from which the safety information data was ingested. Provides data lineage and traceability for audit purposes.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugSafetyInformation_ingestedAt">
        <rdfs:label>ingestedAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugSafetyInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp recording when the safety information data was ingested into the system. Enables data freshness tracking and temporal analysis.</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugSafetyInformation_ingestionMethod">
        <rdfs:label>ingestionMethod</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugSafetyInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the technical method or process used to ingest the safety information data. Documents the ETL process for operational tracking.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- ========================================
         Object Properties (Relationships)
         ======================================== -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_has_drugDosageForm">
        <rdfs:label>hasDosageForm</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugDosageForm"/>
        <rdfs:comment>A drug product has one or more dosage forms</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugDosageForm_belongs_to_drugProduct"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>drugProduct</ont:fromEntityId>
        <ont:toEntityId>drugDosageForm</ont:toEntityId>
        <ont:joinKey>drug_id=drug_id</ont:joinKey>
        <ont:sourceRelationship>drug_product_to_drug_dosage_forms</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugDosageForm_belongs_to_drugProduct">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>belongsTo</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugDosageForm"/>
        <rdfs:range rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:comment>A dosage form belongs to exactly one drug product</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_has_drugDosageForm"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>drugDosageForm</ont:fromEntityId>
        <ont:toEntityId>drugProduct</ont:toEntityId>
        <ont:joinKey>drug_id=drug_id</ont:joinKey>
        <ont:sourceRelationship>drug_product_to_drug_dosage_forms</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_has_drugIndication">
        <rdfs:label>hasIndication</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugIndication"/>
        <rdfs:comment>A drug product has one or more indications</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugIndication_belongs_to_drugProduct"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>drugProduct</ont:fromEntityId>
        <ont:toEntityId>drugIndication</ont:toEntityId>
        <ont:joinKey>drug_id=drug_id</ont:joinKey>
        <ont:sourceRelationship>drug_product_to_drug_indications</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugIndication_belongs_to_drugProduct">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>belongsTo</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugIndication"/>
        <rdfs:range rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:comment>An indication belongs to exactly one drug product</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_has_drugIndication"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>drugIndication</ont:fromEntityId>
        <ont:toEntityId>drugProduct</ont:toEntityId>
        <ont:joinKey>drug_id=drug_id</ont:joinKey>
        <ont:sourceRelationship>drug_product_to_drug_indications</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_has_drugSafetyInformation">
        <rdfs:label>hasSafetyInformation</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:range rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugSafetyInformation"/>
        <rdfs:comment>A drug product has one or more safety information records</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugSafetyInformation_belongs_to_drugProduct"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>drugProduct</ont:fromEntityId>
        <ont:toEntityId>drugSafetyInformation</ont:toEntityId>
        <ont:joinKey>drug_id=drug_id</ont:joinKey>
        <ont:sourceRelationship>drug_product_to_drug_safety_information</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugSafetyInformation_belongs_to_drugProduct">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>belongsTo</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugSafetyInformation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <rdfs:comment>A safety information record belongs to exactly one drug product</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/drugProduct_has_drugSafetyInformation"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>drugSafetyInformation</ont:fromEntityId>
        <ont:toEntityId>drugProduct</ont:toEntityId>
        <ont:joinKey>drug_id=drug_id</ont:joinKey>
        <ont:sourceRelationship>drug_product_to_drug_safety_information</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- ========================================
         Data Bindings
         ======================================== -->

    <ont:DataBinding rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/binding_drugProduct">
        <ont:boundClass rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugProduct"/>
        <ont:boundEntityId>drugProduct</ont:boundEntityId>
        <ont:source>Databricks</ont:source>
        <ont:table>entyvio_bronze.drug_product</ont:table>
        <ont:columnMapping>productId=product_id</ont:columnMapping>
        <ont:columnMapping>drugId=drug_id</ont:columnMapping>
        <ont:columnMapping>brandName=brand_name</ont:columnMapping>
        <ont:columnMapping>genericName=generic_name</ont:columnMapping>
        <ont:columnMapping>activeIngredient=active_ingredient</ont:columnMapping>
        <ont:columnMapping>manufacturer=manufacturer</ont:columnMapping>
        <ont:columnMapping>therapeuticArea=therapeutic_area</ont:columnMapping>
        <ont:columnMapping>drugClass=drug_class</ont:columnMapping>
        <ont:columnMapping>moleculeType=molecule_type</ont:columnMapping>
        <ont:columnMapping>market=market</ont:columnMapping>
        <ont:columnMapping>productPresentation=product_presentation</ont:columnMapping>
        <ont:columnMapping>approvalYear=approval_year</ont:columnMapping>
        <ont:columnMapping>productStatus=product_status</ont:columnMapping>
        <ont:columnMapping>sourceFile=_source_file</ont:columnMapping>
        <ont:columnMapping>ingestedAt=_ingested_at</ont:columnMapping>
        <ont:columnMapping>ingestionMethod=_ingestion_method</ont:columnMapping>
    </ont:DataBinding>

    <ont:DataBinding rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/binding_drugDosageForm">
        <ont:boundClass rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugDosageForm"/>
        <ont:boundEntityId>drugDosageForm</ont:boundEntityId>
        <ont:source>Databricks</ont:source>
        <ont:table>entyvio_bronze.drug_dosage_forms</ont:table>
        <ont:columnMapping>dosageFormId=dosage_form_id</ont:columnMapping>
        <ont:columnMapping>drugId=drug_id</ont:columnMapping>
        <ont:columnMapping>dosageForm=dosage_form</ont:columnMapping>
        <ont:columnMapping>strength=strength</ont:columnMapping>
        <ont:columnMapping>routeOfAdministration=route_of_administration</ont:columnMapping>
        <ont:columnMapping>packageDescription=package_description</ont:columnMapping>
        <ont:columnMapping>sourceFile=_source_file</ont:columnMapping>
        <ont:columnMapping>ingestedAt=_ingested_at</ont:columnMapping>
        <ont:columnMapping>ingestionMethod=_ingestion_method</ont:columnMapping>
    </ont:DataBinding>

    <ont:DataBinding rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/binding_drugIndication">
        <ont:boundClass rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugIndication"/>
        <ont:boundEntityId>drugIndication</ont:boundEntityId>
        <ont:source>Databricks</ont:source>
        <ont:table>entyvio_bronze.drug_indications</ont:table>
        <ont:columnMapping>indicationId=indication_id</ont:columnMapping>
        <ont:columnMapping>drugId=drug_id</ont:columnMapping>
        <ont:columnMapping>indicationName=indication_name</ont:columnMapping>
        <ont:columnMapping>indicationCategory=indication_category</ont:columnMapping>
        <ont:columnMapping>indicationDescription=indication_description</ont:columnMapping>
        <ont:columnMapping>evidenceLevel=evidence_level</ont:columnMapping>
        <ont:columnMapping>sourceFile=_source_file</ont:columnMapping>
        <ont:columnMapping>ingestedAt=_ingested_at</ont:columnMapping>
        <ont:columnMapping>ingestionMethod=_ingestion_method</ont:columnMapping>
    </ont:DataBinding>

    <ont:DataBinding rdf:about="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/binding_drugSafetyInformation">
        <ont:boundClass rdf:resource="http://example.org/ontology/entyvio-pharmaceutical-semantic-model/DrugSafetyInformation"/>
        <ont:boundEntityId>drugSafetyInformation</ont:boundEntityId>
        <ont:source>Databricks</ont:source>
        <ont:table>entyvio_bronze.drug_safety_information</ont:table>
        <ont:columnMapping>safetyId=safety_id</ont:columnMapping>
        <ont:columnMapping>drugId=drug_id</ont:columnMapping>
        <ont:columnMapping>safetyType=safety_type</ont:columnMapping>
        <ont:columnMapping>safetyText=safety_text</ont:columnMapping>
        <ont:columnMapping>severity=severity</ont:columnMapping>
        <ont:columnMapping>sourceId=source_id</ont:columnMapping>
        <ont:columnMapping>sourceFile=_source_file</ont:columnMapping>
        <ont:columnMapping>ingestedAt=_ingested_at</ont:columnMapping>
        <ont:columnMapping>ingestionMethod=_ingestion_method</ont:columnMapping>
    </ont:DataBinding>

</rdf:RDF>
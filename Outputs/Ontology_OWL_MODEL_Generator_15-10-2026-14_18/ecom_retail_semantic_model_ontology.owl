    <owl:Class rdf:about="http://example.org/ontology/ecom-retail-semantic-model/Customer">
        <rdfs:label>Customer</rdfs:label>
        <skos:prefLabel>Customers</skos:prefLabel>
        <rdfs:comment>Retail e-commerce customer entity containing master data for customer demographics, contact information, address, segmentation, and registration details.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/ecom-retail-semantic-model/"/>
        <ont:icon>👤</ont:icon>
        <ont:iconCode>U+1F464</ont:iconCode>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/ecom-retail-semantic-model/Order">
        <rdfs:label>Order</rdfs:label>
        <skos:prefLabel>Orders</skos:prefLabel>
        <rdfs:comment>Customer order transaction entity containing order header information, customer reference, order timing, status, sales channel, shipping address, and complete order financial details.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/ecom-retail-semantic-model/"/>
        <ont:icon>🧾</ont:icon>
        <ont:iconCode>U+1F9FE</ont:iconCode>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/ecom-retail-semantic-model/OrderItem">
        <rdfs:label>OrderItem</rdfs:label>
        <skos:prefLabel>Order Items</skos:prefLabel>
        <rdfs:comment>Order line item entity containing product reference, quantity, unit pricing, line-level discounts, and line totals for detailed order composition analysis.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/ecom-retail-semantic-model/"/>
        <ont:icon>🛒</ont:icon>
        <ont:iconCode>U+1F6D2</ont:iconCode>
        <ont:color>#00B7C3</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/ecom-retail-semantic-model/Product">
        <rdfs:label>Product</rdfs:label>
        <skos:prefLabel>Products</skos:prefLabel>
        <rdfs:comment>Product catalog entity containing product identification, naming, category classification, brand, pricing, cost, inventory, and status information.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/ecom-retail-semantic-model/"/>
        <ont:icon>📦</ont:icon>
        <ont:iconCode>U+1F4E6</ont:iconCode>
        <ont:color>#5C2D91</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/ecom-retail-semantic-model/ProductCategory">
        <rdfs:label>ProductCategory</rdfs:label>
        <skos:prefLabel>Product Categories</skos:prefLabel>
        <rdfs:comment>Product category entity with hierarchical structure containing category identification, naming, parent category reference for hierarchy, and status.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/ecom-retail-semantic-model/"/>
        <ont:icon>📂</ont:icon>
        <ont:iconCode>U+1F4C2</ont:iconCode>
        <ont:color>#CA5010</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/ecom-retail-semantic-model/Payment">
        <rdfs:label>Payment</rdfs:label>
        <skos:prefLabel>Payments</skos:prefLabel>
        <rdfs:comment>Payment transaction entity containing order reference, payment method, payment status, amount, currency, transaction reference, gateway, and payment timing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/ecom-retail-semantic-model/"/>
        <ont:icon>💳</ont:icon>
        <ont:iconCode>U+1F4B3</ont:iconCode>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/ecom-retail-semantic-model/Shipment">
        <rdfs:label>Shipment</rdfs:label>
        <skos:prefLabel>Shipments</skos:prefLabel>
        <rdfs:comment>Shipment and delivery entity containing order reference, carrier, tracking number, shipment status, shipping and delivery timestamps, and destination address.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/ecom-retail-semantic-model/"/>
        <ont:icon>🚚</ont:icon>
        <ont:iconCode>U+1F69A</ont:iconCode>
        <ont:color>#D83B01</ont:color>
    </owl:Class>


    <owl:Ontology rdf:about="http://example.org/ontology/ecom-retail-semantic-model/">
        <owl:versionIRI rdf:resource="http://example.org/ontology/ecom-retail-semantic-model/1.0/"/>
        <owl:versionInfo>1.0</owl:versionInfo>
        <rdfs:label>Ecom Retail Semantic Model</rdfs:label>
        <rdfs:comment>Comprehensive semantic model for retail e-commerce analytics derived from the ecom_bronze schema. This model supports analytical queries across customers, orders, products, payments, and shipments. The model includes customer segmentation analysis, order fulfillment tracking, product performance, payment processing analytics, and hierarchical product categorization.</rdfs:comment>
        <dcterms:source>Context-01.yaml</dcterms:source>
        <ont:sourceFormat>OSI Semantic Model</ont:sourceFormat>
    </owl:Ontology>


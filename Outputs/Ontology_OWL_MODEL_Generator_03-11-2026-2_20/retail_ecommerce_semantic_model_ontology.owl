    <!-- ============================================================
         ONTOLOGY HEADER
         ============================================================ -->

    <owl:Ontology rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/">
        <owl:versionIRI rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/1.0/"/>
        <owl:versionInfo>1.0</owl:versionInfo>
        <rdfs:label>Retail Ecommerce Semantic Model</rdfs:label>
        <rdfs:comment>Comprehensive semantic model for retail e-commerce analytics derived from the APPUSER schema. This model supports analytical queries across customers, orders, products, payments, and shipments. The model includes 8 core datasets with complete relationship mapping, measures, dimensions, and business metrics for revenue analysis, customer analytics, product performance, and fulfillment operations.</rdfs:comment>
        <dcterms:source>Context-Ecom.yaml</dcterms:source>
        <ont:sourceFormat>OSI Semantic Model</ont:sourceFormat>
    </owl:Ontology>


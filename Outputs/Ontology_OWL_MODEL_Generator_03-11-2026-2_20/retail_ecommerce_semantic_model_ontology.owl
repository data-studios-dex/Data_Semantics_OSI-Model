        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Postal or ZIP code of the customer&apos;s address. Marked as PII.</rdfs:comment>
        <ont:isPII rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isPII>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/customer_customerSegment">

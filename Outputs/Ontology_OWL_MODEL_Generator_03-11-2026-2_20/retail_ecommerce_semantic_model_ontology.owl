        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Customer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Segment or category to which the customer has been assigned (e.g., Premium, Standard, VIP).</rdfs:comment>

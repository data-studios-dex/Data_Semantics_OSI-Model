    <!-- Order properties -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_orderId">
        <rdfs:label>orderId</rdfs:label>
        <skos:prefLabel>Order Identifier</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Unique identifier for an order.</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_orderNumber">
        <rdfs:label>orderNumber</rdfs:label>
        <skos:prefLabel>Order Number</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Business order number used to reference the order.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_customerId">
        <rdfs:label>customerId</rdfs:label>
        <skos:prefLabel>Customer Reference</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>References the related customer who placed the order. Foreign key to customers.customer_id.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_orderDate">
        <rdfs:label>orderDate</rdfs:label>
        <skos:prefLabel>Order Date</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp recording when the order was placed. Use for order timing and revenue trending analysis.</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_orderStatus">
        <rdfs:label>orderStatus</rdfs:label>
        <skos:prefLabel>Order Status</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the current processing status of the order (e.g., Completed, Pending, Cancelled).</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_salesChannel">
        <rdfs:label>salesChannel</rdfs:label>
        <skos:prefLabel>Sales Channel</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Sales channel through which the order was placed (e.g., Online, In-Store, Mobile).</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_shipCity">
        <rdfs:label>shipCity</rdfs:label>
        <skos:prefLabel>Ship City</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>City to which the order is being shipped. Marked as PII.</rdfs:comment>
        <ont:isPII rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isPII>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_shipState">
        <rdfs:label>shipState</rdfs:label>
        <skos:prefLabel>Ship State</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>State or province to which the order is being shipped. Marked as PII.</rdfs:comment>
        <ont:isPII rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isPII>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_shipPostalCode">
        <rdfs:label>shipPostalCode</rdfs:label>
        <skos:prefLabel>Ship Postal Code</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Postal or ZIP code of the shipping address for the order. Marked as PII.</rdfs:comment>
        <ont:isPII rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isPII>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_currency">
        <rdfs:label>currency</rdfs:label>
        <skos:prefLabel>Currency</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Currency code used for monetary amounts on the order (e.g., USD, EUR, GBP).</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- Order measures -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_subtotal">
        <rdfs:label>subtotal</rdfs:label>
        <skos:prefLabel>Subtotal</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount representing the order subtotal before discounts and taxes. Use for gross revenue analysis.</rdfs:comment>
        <ont:isMeasure rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isMeasure>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_discountAmount">
        <rdfs:label>discountAmount</rdfs:label>
        <skos:prefLabel>Discount Amount</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount representing discounts applied to the order. Use for discount analysis.</rdfs:comment>
        <ont:isMeasure rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isMeasure>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_taxAmount">
        <rdfs:label>taxAmount</rdfs:label>
        <skos:prefLabel>Tax Amount</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount representing taxes applied to the order. Marked as PII.</rdfs:comment>
        <ont:isPII rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isPII>
        <ont:isMeasure rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isMeasure>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_shippingFee">
        <rdfs:label>shippingFee</rdfs:label>
        <skos:prefLabel>Shipping Fee</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount charged for shipping the order. Use for shipping cost analysis.</rdfs:comment>
        <ont:isMeasure rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isMeasure>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_totalAmount">
        <rdfs:label>totalAmount</rdfs:label>
        <skos:prefLabel>Total Amount</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount representing the total cost of the order including discounts, taxes, and fees. Use for total order revenue analysis. Do NOT sum this field after joining to order_items to avoid double-counting.</rdfs:comment>
        <ont:isMeasure rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isMeasure>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- OrderItem properties -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/orderItem_orderItemId">
        <rdfs:label>orderItemId</rdfs:label>
        <skos:prefLabel>Order Item Identifier</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Unique identifier for an order line item.</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/orderItem_orderId">
        <rdfs:label>orderId</rdfs:label>
        <skos:prefLabel>Order Reference</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>References the related order that this line item belongs to. Foreign key to orders.order_id.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/orderItem_lineNumber">
        <rdfs:label>lineNumber</rdfs:label>
        <skos:prefLabel>Line Number</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Sequence number of the line item within the order.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/orderItem_productId">
        <rdfs:label>productId</rdfs:label>
        <skos:prefLabel>Product Reference</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>References the related product being ordered. Foreign key to products.product_id.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- OrderItem measures -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/orderItem_quantity">
        <rdfs:label>quantity</rdfs:label>
        <skos:prefLabel>Quantity</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Number of units of the product ordered on this line. Use for units sold analysis.</rdfs:comment>
        <ont:isMeasure rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isMeasure>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/orderItem_unitPrice">
        <rdfs:label>unitPrice</rdfs:label>
        <skos:prefLabel>Unit Price</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount representing the price per unit for the product at the time of order.</rdfs:comment>
        <ont:isMeasure rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isMeasure>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/orderItem_discountPct">
        <rdfs:label>discountPct</rdfs:label>
        <skos:prefLabel>Discount Pct</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Percentage discount applied to this line item (e.g., 10.00 represents 10%).</rdfs:comment>
        <ont:isMeasure rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isMeasure>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/orderItem_lineTotal">
        <rdfs:label>lineTotal</rdfs:label>
        <skos:prefLabel>Line Total</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/OrderItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount representing the total value of the line after discounts. Calculated as quantity * unit_price * (1 - discount_pct / 100). Use for product-level and line-item-level revenue analysis.</rdfs:comment>
        <ont:isMeasure rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isMeasure>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- Product properties -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/product_productId">
        <rdfs:label>productId</rdfs:label>
        <skos:prefLabel>Product Identifier</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Unique identifier for a product.</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/product_sku">
        <rdfs:label>sku</rdfs:label>
        <skos:prefLabel>Sku</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stock keeping unit code used to uniquely identify the product variant.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/product_productName">
        <rdfs:label>productName</rdfs:label>
        <skos:prefLabel>Product Name</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Descriptive name of the product.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/product_categoryId">
        <rdfs:label>categoryId</rdfs:label>
        <skos:prefLabel>Category Reference</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>References the product category to which this product belongs. Foreign key to product_categories.category_id.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/product_brand">
        <rdfs:label>brand</rdfs:label>
        <skos:prefLabel>Brand</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Brand name associated with the product.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/product_description">
        <rdfs:label>description</rdfs:label>
        <skos:prefLabel>Description</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Short marketing or catalog description of the product.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/product_currency">
        <rdfs:label>currency</rdfs:label>
        <skos:prefLabel>Currency</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Currency code used for product pricing (e.g., USD, EUR, GBP).</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/product_isActive">
        <rdfs:label>isActive</rdfs:label>
        <skos:prefLabel>Is Active</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether the product is currently active and available for sale.</rdfs:comment>
        <ont:propertyType>boolean</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/product_createdAt">
        <rdfs:label>createdAt</rdfs:label>
        <skos:prefLabel>Created At</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp when the product record was first created. Use for product lifecycle analysis.</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- Product measures -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/product_unitPrice">
        <rdfs:label>unitPrice</rdfs:label>
        <skos:prefLabel>Unit Price</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount representing the retail price per unit of the product.</rdfs:comment>
        <ont:isMeasure rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isMeasure>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/product_costPrice">
        <rdfs:label>costPrice</rdfs:label>
        <skos:prefLabel>Cost Price</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount representing the cost to acquire or produce the product. Marked as PII.</rdfs:comment>
        <ont:isPII rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isPII>
        <ont:isMeasure rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isMeasure>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/product_stockQuantity">
        <rdfs:label>stockQuantity</rdfs:label>
        <skos:prefLabel>Stock Quantity</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Current quantity of the product available in inventory. Use for inventory analysis.</rdfs:comment>
        <ont:isMeasure rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isMeasure>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- ProductCategory properties -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/productCategory_categoryId">
        <rdfs:label>categoryId</rdfs:label>
        <skos:prefLabel>Category Identifier</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/ProductCategory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Unique identifier for a product category.</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/productCategory_categoryName">
        <rdfs:label>categoryName</rdfs:label>
        <skos:prefLabel>Category Name</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/ProductCategory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Descriptive name of the product category.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/productCategory_parentCategoryId">
        <rdfs:label>parentCategoryId</rdfs:label>
        <skos:prefLabel>Parent Category Reference</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/ProductCategory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>References the parent category in the category hierarchy. Foreign key to product_categories.category_id. This creates a self-referencing hierarchical relationship. NULL indicates a root category.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/productCategory_description">
        <rdfs:label>description</rdfs:label>
        <skos:prefLabel>Description</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/ProductCategory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Text description of the product category.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/productCategory_isActive">
        <rdfs:label>isActive</rdfs:label>
        <skos:prefLabel>Is Active</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/ProductCategory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates whether the category is currently active and in use.</rdfs:comment>
        <ont:propertyType>boolean</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- Payment properties -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/payment_paymentId">
        <rdfs:label>paymentId</rdfs:label>
        <skos:prefLabel>Payment Identifier</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Unique identifier for a payment.</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/payment_orderId">
        <rdfs:label>orderId</rdfs:label>
        <skos:prefLabel>Order Reference</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>References the related order that the payment is applied to. Foreign key to orders.order_id.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/payment_paymentMethod">
        <rdfs:label>paymentMethod</rdfs:label>
        <skos:prefLabel>Payment Method</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Method used to make the payment, such as credit card, PayPal, or bank transfer.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/payment_paymentStatus">
        <rdfs:label>paymentStatus</rdfs:label>
        <skos:prefLabel>Payment Status</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the current processing status of the payment (e.g., Settled, Pending, Failed).</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/payment_currency">
        <rdfs:label>currency</rdfs:label>
        <skos:prefLabel>Currency</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Currency code used for the payment amount (e.g., USD, EUR, GBP).</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/payment_transactionRef">
        <rdfs:label>transactionRef</rdfs:label>
        <skos:prefLabel>Transaction Ref</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Reference code from the payment processor for the transaction. Marked as PII.</rdfs:comment>
        <ont:isPII rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isPII>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/payment_gateway">
        <rdfs:label>gateway</rdfs:label>
        <skos:prefLabel>Gateway</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of the payment gateway or provider that processed the payment (e.g., Stripe, PayPal).</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/payment_paidAt">
        <rdfs:label>paidAt</rdfs:label>
        <skos:prefLabel>Paid At</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp recording when the payment was completed. Use for payment timing and cash flow analysis.</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- Payment measures -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/payment_amount">
        <rdfs:label>amount</rdfs:label>
        <skos:prefLabel>Amount</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Monetary amount received in the payment. Use for payment transaction analysis.</rdfs:comment>
        <ont:isMeasure rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isMeasure>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- Shipment properties -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/shipment_shipmentId">
        <rdfs:label>shipmentId</rdfs:label>
        <skos:prefLabel>Shipment Identifier</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Unique identifier for a shipment.</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/shipment_orderId">
        <rdfs:label>orderId</rdfs:label>
        <skos:prefLabel>Order Reference</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>References the related order that is being shipped. Foreign key to orders.order_id.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/shipment_carrier">
        <rdfs:label>carrier</rdfs:label>
        <skos:prefLabel>Carrier</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of the shipping carrier handling the shipment (e.g., UPS, FedEx, USPS).</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/shipment_trackingNumber">
        <rdfs:label>trackingNumber</rdfs:label>
        <skos:prefLabel>Tracking Number</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Tracking number assigned by the carrier for the shipment. Marked as PII.</rdfs:comment>
        <ont:isPII rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isPII>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/shipment_shipmentStatus">
        <rdfs:label>shipmentStatus</rdfs:label>
        <skos:prefLabel>Shipment Status</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the current status of the shipment (e.g., In Transit, Delivered, Pending).</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/shipment_shippedAt">
        <rdfs:label>shippedAt</rdfs:label>
        <skos:prefLabel>Shipped At</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp recording when the shipment was dispatched. Use for shipment timing analysis.</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/shipment_deliveredAt">
        <rdfs:label>deliveredAt</rdfs:label>
        <skos:prefLabel>Delivered At</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp recording when the shipment was delivered to the customer. Use for delivery completion analysis.</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/shipment_shipCity">
        <rdfs:label>shipCity</rdfs:label>
        <skos:prefLabel>Ship City</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>City to which the shipment is being delivered. Marked as PII.</rdfs:comment>
        <ont:isPII rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isPII>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/shipment_shipState">
        <rdfs:label>shipState</rdfs:label>
        <skos:prefLabel>Ship State</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>State or province to which the shipment is being delivered. Marked as PII.</rdfs:comment>
        <ont:isPII rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isPII>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/shipment_shipPostalCode">
        <rdfs:label>shipPostalCode</rdfs:label>
        <skos:prefLabel>Ship Postal Code</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Shipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Postal or ZIP code of the shipment delivery address. Marked as PII.</rdfs:comment>
        <ont:isPII rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isPII>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- CategorySummary properties -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/categorySummary_summaryKey">
        <rdfs:label>summaryKey</rdfs:label>
        <skos:prefLabel>Summary Key Identifier</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/CategorySummary"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Unique identifier for the category summary record.</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/categorySummary_minFilter">
        <rdfs:label>minFilter</rdfs:label>
        <skos:prefLabel>Min Filter</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/CategorySummary"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Minimum filter value used when calculating the category summary.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/categorySummary_minId">
        <rdfs:label>minId</rdfs:label>
        <skos:prefLabel>Min Id</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/CategorySummary"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Lowest identifier value among the records included in the summary.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/categorySummary_maxId">
        <rdfs:label>maxId</rdfs:label>
        <skos:prefLabel>Max Id</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/CategorySummary"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Highest identifier value among the records included in the summary.</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- CategorySummary measures -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/categorySummary_rowCount">
        <rdfs:label>rowCount</rdfs:label>
        <skos:prefLabel>Row Count</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/CategorySummary"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Total number of rows included in the category summary.</rdfs:comment>
        <ont:isMeasure rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isMeasure>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- ============================================================
         OBJECT PROPERTIES (RELATIONSHIPS)
         ============================================================ -->

    <!-- orders_to_customers: Order -> Customer -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_placed_by_customer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>placedBy</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Customer"/>
        <rdfs:comment>An order is placed by exactly one customer.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/customer_places_order"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>customer</ont:toEntityId>
        <ont:joinKey>customer_id=customer_id</ont:joinKey>
        <ont:sourceRelationship>orders_to_customers</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/customer_places_order">
        <rdfs:label>places</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Customer"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:comment>A customer places one or more orders.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/order_placed_by_customer"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>customer</ont:fromEntityId>
        <ont:toEntityId>order</ont:toEntityId>
        <ont:joinKey>customer_id=customer_id</ont:joinKey>
        <ont:sourceRelationship>orders_to_customers</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- order_items_to_orders: OrderItem -> Order -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/orderItem_belongs_to_order">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>belongsTo</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/OrderItem"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:comment>An order line item belongs to exactly one order.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/order_contains_orderItem"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>orderItem</ont:fromEntityId>
        <ont:toEntityId>order</ont:toEntityId>
        <ont:joinKey>order_id=order_id</ont:joinKey>
        <ont:sourceRelationship>order_items_to_orders</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_contains_orderItem">
        <rdfs:label>contains</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/OrderItem"/>
        <rdfs:comment>An order contains one or more order line items.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/orderItem_belongs_to_order"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>orderItem</ont:toEntityId>
        <ont:joinKey>order_id=order_id</ont:joinKey>
        <ont:sourceRelationship>order_items_to_orders</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- order_items_to_products: OrderItem -> Product -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/orderItem_refers_to_product">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>refersTo</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/OrderItem"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:comment>An order line item refers to exactly one product.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/product_appears_in_orderItem"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>orderItem</ont:fromEntityId>
        <ont:toEntityId>product</ont:toEntityId>
        <ont:joinKey>product_id=product_id</ont:joinKey>
        <ont:sourceRelationship>order_items_to_products</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/product_appears_in_orderItem">
        <rdfs:label>appearsIn</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/OrderItem"/>
        <rdfs:comment>A product appears in one or more order line items.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/orderItem_refers_to_product"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>product</ont:fromEntityId>
        <ont:toEntityId>orderItem</ont:toEntityId>
        <ont:joinKey>product_id=product_id</ont:joinKey>
        <ont:sourceRelationship>order_items_to_products</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- products_to_product_categories: Product -> ProductCategory -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/product_classified_in_productCategory">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>classifiedIn</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/ProductCategory"/>
        <rdfs:comment>A product is classified in exactly one product category.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/productCategory_classifies_product"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>product</ont:fromEntityId>
        <ont:toEntityId>productCategory</ont:toEntityId>
        <ont:joinKey>category_id=category_id</ont:joinKey>
        <ont:sourceRelationship>products_to_product_categories</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/productCategory_classifies_product">
        <rdfs:label>classifies</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/ProductCategory"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Product"/>
        <rdfs:comment>A product category classifies one or more products.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/product_classified_in_productCategory"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>productCategory</ont:fromEntityId>
        <ont:toEntityId>product</ont:toEntityId>
        <ont:joinKey>category_id=category_id</ont:joinKey>
        <ont:sourceRelationship>products_to_product_categories</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- payments_to_orders: Payment -> Order -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/payment_settles_order">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>settles</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Payment"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:comment>A payment settles exactly one order.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/order_paid_by_payment"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>payment</ont:fromEntityId>
        <ont:toEntityId>order</ont:toEntityId>
        <ont:joinKey>order_id=order_id</ont:joinKey>
        <ont:sourceRelationship>payments_to_orders</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_paid_by_payment">
        <rdfs:label>paidBy</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Payment"/>
        <rdfs:comment>An order is paid by one or more payment transactions.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/payment_settles_order"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>payment</ont:toEntityId>
        <ont:joinKey>order_id=order_id</ont:joinKey>
        <ont:sourceRelationship>payments_to_orders</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- shipments_to_orders: Shipment -> Order -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/shipment_delivers_order">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>delivers</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Shipment"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:comment>A shipment delivers exactly one order.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/order_fulfilled_by_shipment"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>shipment</ont:fromEntityId>
        <ont:toEntityId>order</ont:toEntityId>
        <ont:joinKey>order_id=order_id</ont:joinKey>
        <ont:sourceRelationship>shipments_to_orders</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/order_fulfilled_by_shipment">
        <rdfs:label>fulfilledBy</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/Shipment"/>
        <rdfs:comment>An order is fulfilled by one or more shipments.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/shipment_delivers_order"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>shipment</ont:toEntityId>
        <ont:joinKey>order_id=order_id</ont:joinKey>
        <ont:sourceRelationship>shipments_to_orders</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- product_categories_hierarchy: ProductCategory -> ProductCategory (self-reference) -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/productCategory_has_parent_productCategory">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>hasParent</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/ProductCategory"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/ProductCategory"/>
        <rdfs:comment>A product category has at most one parent category in the hierarchy.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/productCategory_has_child_productCategory"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>productCategory</ont:fromEntityId>
        <ont:toEntityId>productCategory</ont:toEntityId>
        <ont:joinKey>parent_category_id=category_id</ont:joinKey>
        <ont:sourceRelationship>product_categories_hierarchy</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/productCategory_has_child_productCategory">
        <rdfs:label>hasChild</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/ProductCategory"/>
        <rdfs:range rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/ProductCategory"/>
        <rdfs:comment>A product category has zero or more child categories in the hierarchy.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/productCategory_has_parent_productCategory"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>productCategory</ont:fromEntityId>
        <ont:toEntityId>productCategory</ont:toEntityId>
        <ont:joinKey>parent_category_id=category_id</ont:joinKey>
        <ont:sourceRelationship>product_categories_hierarchy</ont:sourceRelationship>
    </owl:ObjectProperty>


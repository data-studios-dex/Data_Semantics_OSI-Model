    <!-- ============================================================
         ENTITY TYPES (CLASSES)
         ============================================================ -->

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/Customer">
        <rdfs:label>Customer</rdfs:label>
        <skos:prefLabel>Customers</skos:prefLabel>
        <rdfs:comment>A registered individual who interacts with the retail platform, identified by a unique customer identifier and associated with demographic, contact, location, and segmentation attributes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/"/>
        <ont:icon>👤</ont:icon>
        <ont:iconCode>U+1F464</ont:iconCode>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/Order">
        <rdfs:label>Order</rdfs:label>
        <skos:prefLabel>Orders</skos:prefLabel>
        <rdfs:comment>A purchase transaction placed by a customer through a sales channel, capturing order identification, timing, status, shipping destination, and order-level financial totals.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/"/>
        <ont:icon>🧾</ont:icon>
        <ont:iconCode>U+1F9FE</ont:iconCode>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/OrderItem">
        <rdfs:label>OrderItem</rdfs:label>
        <skos:prefLabel>Order Items</skos:prefLabel>
        <rdfs:comment>A single line within an order representing a specific product, its ordered quantity, unit price, applicable discount, and the resulting line total.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/"/>
        <ont:icon>🛒</ont:icon>
        <ont:iconCode>U+1F6D2</ont:iconCode>
        <ont:color>#00B7C3</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/Product">
        <rdfs:label>Product</rdfs:label>
        <skos:prefLabel>Products</skos:prefLabel>
        <rdfs:comment>A sellable item in the product catalog, described by its SKU, name, brand, category, pricing, inventory quantity, and active status.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/"/>
        <ont:icon>📦</ont:icon>
        <ont:iconCode>U+1F4E6</ont:iconCode>
        <ont:color>#5C2D91</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/ProductCategory">
        <rdfs:label>ProductCategory</rdfs:label>
        <skos:prefLabel>Product Categories</skos:prefLabel>
        <rdfs:comment>A hierarchical grouping used to classify products, where each category may reference a parent category to form a tree structure with root categories having no parent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/"/>
        <ont:icon>📂</ont:icon>
        <ont:iconCode>U+1F4C2</ont:iconCode>
        <ont:color>#CA5010</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/Payment">
        <rdfs:label>Payment</rdfs:label>
        <skos:prefLabel>Payments</skos:prefLabel>
        <rdfs:comment>A financial transaction that settles an order, recording the payment method, status, amount, currency, transaction reference, gateway, and completion timestamp.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/"/>
        <ont:icon>💳</ont:icon>
        <ont:iconCode>U+1F4B3</ont:iconCode>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/Shipment">
        <rdfs:label>Shipment</rdfs:label>
        <skos:prefLabel>Shipments</skos:prefLabel>
        <rdfs:comment>A physical dispatch of goods linked to an order, tracking the carrier, tracking number, shipment status, dispatch and delivery timestamps, and delivery destination.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/"/>
        <ont:icon>🚚</ont:icon>
        <ont:iconCode>U+1F69A</ont:iconCode>
        <ont:color>#D83B01</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/CategorySummary">
        <rdfs:label>CategorySummary</rdfs:label>
        <skos:prefLabel>Category Summary</skos:prefLabel>
        <rdfs:comment>A pre-aggregated summary record for a product category, capturing filter parameters, row count, and identifier range to support performance-optimised category-level analysis.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/retail-ecommerce-semantic-model/"/>
        <ont:icon>📊</ont:icon>
        <ont:iconCode>U+1F4CA</ont:iconCode>
        <ont:color>#E3008C</ont:color>
    </owl:Class>


        <rdfs:label>DataBinding</rdfs:label>
    </owl:Class>

    <!-- ================================================================ -->
    <!-- Entity Types (Classes)                                           -->
    <!-- ================================================================ -->

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/Customer">
        <rdfs:label>Customer</rdfs:label>
        <rdfs:comment>Customer master data for retail e-commerce operations including identifiers, contact information, demographic attributes, address details, customer segmentation, registration date, and account status.</rdfs:comment>
        <ont:icon>👤</ont:icon>
        <ont:iconCode>U+1F464</ont:iconCode>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/Order">
        <rdfs:label>Order</rdfs:label>
        <rdfs:comment>Customer order transactions for retail e-commerce operations including order identifiers, customer reference, order date, order status, sales channel, shipping address, and order amounts.</rdfs:comment>
        <ont:icon>🧾</ont:icon>
        <ont:iconCode>U+1F9FE</ont:iconCode>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/OrderItem">
        <rdfs:label>OrderItem</rdfs:label>
        <rdfs:comment>Order line item details for retail e-commerce operations including order item identifier, order reference, line number, product reference, quantity, unit price, discount percentage, and line total.</rdfs:comment>
        <ont:icon>🛒</ont:icon>
        <ont:iconCode>U+1F6D2</ont:iconCode>
        <ont:color>#00B7C3</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/Product">
        <rdfs:label>Product</rdfs:label>
        <rdfs:comment>Product master data for retail e-commerce operations including product identifiers, SKU, product name, category reference, brand, description, pricing, currency, inventory quantity, active status, and creation timestamp.</rdfs:comment>
        <ont:icon>📦</ont:icon>
        <ont:iconCode>U+1F4E6</ont:iconCode>
        <ont:color>#5C2D91</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/ProductCategory">
        <rdfs:label>ProductCategory</rdfs:label>
        <rdfs:comment>Product category master data with hierarchical structure for retail e-commerce operations including category identifier, category name, parent category reference for hierarchical grouping, description, and active status.</rdfs:comment>
        <ont:icon>📂</ont:icon>
        <ont:iconCode>U+1F4C2</ont:iconCode>
        <ont:color>#CA5010</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/Payment">
        <rdfs:label>Payment</rdfs:label>
        <rdfs:comment>Payment transaction data for retail e-commerce operations including payment identifier, order reference, payment method, payment status, amount, currency, transaction reference, gateway, and payment timestamp.</rdfs:comment>
        <ont:icon>💳</ont:icon>
        <ont:iconCode>U+1F4B3</ont:iconCode>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/retail-ecommerce-semantic-model/Shipment">
        <rdfs:label>Shipment</rdfs:label>
        <rdfs:comment>Shipment tracking data for retail e-commerce operations including shipment identifier, order reference, carrier, tracking number, shipment status, shipped timestamp, delivered timestamp, and destination address.</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:iconCode>U+1F69A</ont:iconCode>
        <ont:color>#D83B01</ont:color>
    </owl:Class>


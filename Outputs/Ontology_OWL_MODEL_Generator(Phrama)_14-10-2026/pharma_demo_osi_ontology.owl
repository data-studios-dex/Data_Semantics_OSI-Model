    xmlns:dcterms="http://purl.org/dc/terms/">

    <!-- ================================================================ -->
    <!-- Ontology Header                                                  -->
    <!-- ================================================================ -->

    <owl:Ontology rdf:about="http://example.org/ontology/pharma-demo-osi/">
        <owl:versionIRI rdf:resource="http://example.org/ontology/pharma-demo-osi/1.0/"/>
        <owl:versionInfo>1.0</owl:versionInfo>
        <rdfs:label>Pharma Demo Osi</rdfs:label>
        <rdfs:comment>Databricks Unity Catalog Metric View for Entyvio Pharmaceutical Semantic Model Generated from OSI Semantic Model version 1.0 Source: entyvio_pharmaceutical_semantic_model Catalog: pharma_demo Schema: entyvio_bronze This metric view provides comprehensive pharmaceutical analytics across drug products, dosage forms, indications, and safety information. The view is built on the drug_product dataset as the central spine, with joins to related datasets for multi-dimensional analysis. Relationships Implemented: - drug_product_to_drug_dosage_forms: One drug product may have multiple dosage forms - drug_product_to_drug_indications: One drug product may have multiple indications - drug_product_to_drug_safety_information: One drug product may have multiple safety records PII Mode: restricted - Technical and audit columns excluded from dimensions DEDUP Mode: off - Order-level aggregation measures not applicable to pharmaceutical domain Metrics Coverage: - Product metrics: total_drug_products, products by manufacturer/therapeutic area/drug class/molecule type/market/status/approval year - Dosage form metrics: total_dosage_forms, dosage forms by type/route of administration - Indication metrics: total_indications, indications by category/evidence level - Safety metrics: total_safety_records, safety records by type/severity - Cross-entity metrics: products with multiple dosage forms/indications, products with high severity safety records - Average metrics: average dosage forms/indications/safety records per product NOT REPRESENTED (domain-specific limitations): - E-commerce metrics (revenue, orders, customers, payments, shipments) are not applicable to pharmaceutical reference data - Transactional metrics require sales/prescription transaction data not present in this product catalog model</rdfs:comment>
        <dcterms:source>pharma_demo_osi.yml</dcterms:source>
        <ont:sourceFormat>Databricks Metric View</ont:sourceFormat>
    </owl:Ontology>


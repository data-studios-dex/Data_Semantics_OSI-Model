    <!-- Identifiers inferred from join keys and key naming. -->
    <owl:Class rdf:about="http://example.org/ontology/pharma-demo-osi/DrugProduct">
        <rdfs:label>DrugProduct</rdfs:label>
        <rdfs:comment>Entity representing pharmaceutical drug products with comprehensive product information, regulatory details, and market characteristics.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/pharma-demo-osi/"/>
        <ont:icon>💊</ont:icon>
        <ont:iconCode>U+1F48A</ont:iconCode>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <!-- Identifiers inferred from join keys and key naming. -->
    <owl:Class rdf:about="http://example.org/ontology/pharma-demo-osi/DrugDosageForm">

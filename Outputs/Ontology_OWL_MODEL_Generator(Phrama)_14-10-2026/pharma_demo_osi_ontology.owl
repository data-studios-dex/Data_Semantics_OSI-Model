    <owl:DatatypeProperty rdf:about="http://example.org/ontology/pharma-demo-osi/drugProduct_drugClass">
        <rdfs:label>drugClass</rdfs:label>
        <skos:prefLabel>Drug Class</skos:prefLabel>

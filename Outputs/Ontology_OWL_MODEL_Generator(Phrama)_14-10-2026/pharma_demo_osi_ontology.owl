        <rdfs:comment>Entity representing pharmaceutical dosage form configurations including formulation type, strength, and route of administration.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/pharma-demo-osi/"/>
        <ont:icon>💉</ont:icon>
        <ont:iconCode>U+1F489</ont:iconCode>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <!-- Identifiers inferred from join keys and key naming. -->

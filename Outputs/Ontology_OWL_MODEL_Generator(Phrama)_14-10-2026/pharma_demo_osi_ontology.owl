        <rdfs:domain rdf:resource="http://example.org/ontology/pharma-demo-osi/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Geographic or regulatory market in which the drug product is approved or sold. Identifies the regulatory jurisdiction and commercial market for the product.</rdfs:comment>
        <ont:typeInferred rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:typeInferred>
        <ont:propertyType>string</ont:propertyType>

        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Pharmacological or therapeutic class of the drug product. Classifies the product by mechanism of action and therapeutic category for pharmacological analysis.</rdfs:comment>
        <ont:typeInferred rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:typeInferred>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/pharma-demo-osi/drugProduct_moleculeType">
        <rdfs:label>moleculeType</rdfs:label>
        <skos:prefLabel>Molecule Type</skos:prefLabel>
        <skos:altLabel>molecular type</skos:altLabel>
        <skos:altLabel>drug type</skos:altLabel>
        <skos:altLabel>molecule class</skos:altLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/pharma-demo-osi/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Type of molecule, such as small molecule or biologic, for the drug product. Distinguishes between traditional chemical drugs and biological therapeutic products.</rdfs:comment>
        <ont:typeInferred rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:typeInferred>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/pharma-demo-osi/drugProduct_market">

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/pharma-demo-osi/drugProduct_productId">
        <rdfs:label>productId</rdfs:label>
        <skos:prefLabel>Product ID</skos:prefLabel>
        <skos:altLabel>product identifier</skos:altLabel>
        <skos:altLabel>drug product id</skos:altLabel>
        <skos:altLabel>product key</skos:altLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/pharma-demo-osi/DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier for the drug product record. Serves as the primary business key for product identification and tracking across the pharmaceutical data ecosystem.</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:typeInferred rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:typeInferred>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/pharma-demo-osi/drugProduct_drugId">
        <rdfs:label>drugId</rdfs:label>
        <skos:prefLabel>Drug ID</skos:prefLabel>

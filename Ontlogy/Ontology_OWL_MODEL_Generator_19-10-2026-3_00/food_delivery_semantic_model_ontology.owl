        <ont:icon>💰</ont:icon>
        <ont:iconCode>U+1F4B0</ont:iconCode>
        <ont:color>#8E562E</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/OrderPromotion">
        <rdfs:label>OrderPromotion</rdfs:label>
        <skos:prefLabel>Order Promotions</skos:prefLabel>
        <rdfs:comment>A record of a promotion applied to a specific order, capturing the discount amount and application timestamp.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>
        <ont:icon>💳</ont:icon>
        <ont:iconCode>U+1F4B3</ont:iconCode>
        <ont:color>#767676</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/Delivery">
        <rdfs:label>Delivery</rdfs:label>
        <skos:prefLabel>Deliveries</skos:prefLabel>
        <rdfs:comment>A delivery record tracking the status, pickup and drop-off times, distance, and agent assignment for an order.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>
        <ont:icon>🚚</ont:icon>
        <ont:iconCode>U+1F69A</ont:iconCode>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/DeliveryAgent">
        <rdfs:label>DeliveryAgent</rdfs:label>
        <skos:prefLabel>Delivery Agents</skos:prefLabel>
        <rdfs:comment>A courier registered on the platform who picks up and delivers orders to customers.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>
        <ont:icon>👥</ont:icon>
        <ont:iconCode>U+1F465</ont:iconCode>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/AgentPayout">
        <rdfs:label>AgentPayout</rdfs:label>
        <skos:prefLabel>Agent Payouts</skos:prefLabel>
        <rdfs:comment>A payout record for a delivery agent covering base pay, distance bonus, tip, and total payout for a delivery.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>
        <ont:icon>📊</ont:icon>
        <ont:iconCode>U+1F4CA</ont:iconCode>
        <ont:color>#00B7C3</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/Payment">
        <rdfs:label>Payment</rdfs:label>
        <skos:prefLabel>Payments</skos:prefLabel>
        <rdfs:comment>A payment transaction record for an order, capturing method, amount, status, and processing details.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>
        <ont:icon>💳</ont:icon>
        <ont:iconCode>U+1F4B3</ont:iconCode>
        <ont:color>#5C2D91</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/Review">
        <rdfs:label>Review</rdfs:label>
        <skos:prefLabel>Reviews</skos:prefLabel>
        <rdfs:comment>A customer review of an order experience, rating food quality, delivery performance, and overall satisfaction.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>
        <ont:icon>📈</ont:icon>
        <ont:iconCode>U+1F4C8</ont:iconCode>
        <ont:color>#CA5010</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/SupportTicket">
        <rdfs:label>SupportTicket</rdfs:label>
        <skos:prefLabel>Support Tickets</skos:prefLabel>
        <rdfs:comment>A customer support request linked to an order, tracking issue category, priority, status, and resolution details.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>
        <ont:icon>🚨</ont:icon>
        <ont:iconCode>U+1F6A8</ont:iconCode>
        <ont:color>#FFB900</ont:color>
    </owl:Class>


        <ont:icon>📄</ont:icon>
        <ont:iconCode>U+1F4C4</ont:iconCode>
        <ont:color>#CA5010</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/MenuSection">
        <rdfs:label>MenuSection</rdfs:label>
        <skos:prefLabel>Menu Sections</skos:prefLabel>
        <rdfs:comment>A logical grouping of menu items within a restaurant menu, such as Appetizers or Desserts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>
        <ont:icon>📅</ont:icon>
        <ont:iconCode>U+1F4C5</ont:iconCode>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/MenuItem">
        <rdfs:label>MenuItem</rdfs:label>
        <skos:prefLabel>Menu Items</skos:prefLabel>

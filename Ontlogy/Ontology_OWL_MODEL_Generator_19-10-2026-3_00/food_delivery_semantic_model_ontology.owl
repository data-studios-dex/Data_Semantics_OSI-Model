    <!-- ============================================================
         ONTOLOGY HEADER
         ============================================================ -->

    <owl:Ontology rdf:about="http://example.org/ontology/food-delivery-semantic-model/">
        <owl:versionIRI rdf:resource="http://example.org/ontology/food-delivery-semantic-model/1.0/"/>
        <owl:versionInfo>1.0</owl:versionInfo>
        <rdfs:label>Food Delivery Semantic Model</rdfs:label>
        <rdfs:comment>Comprehensive semantic model for the food delivery platform analytics. This model supports analytical queries across customers, orders, restaurants, deliveries, agents, payments, promotions, and support operations. The model enables analysis of order fulfillment, revenue, customer behavior, restaurant performance, delivery agent performance, and operational efficiency.</rdfs:comment>
        <dcterms:source>Food-delivery-Context.yaml</dcterms:source>
        <ont:sourceFormat>OSI Semantic Model</ont:sourceFormat>
    </owl:Ontology>

    <!--
        Source file      : Food-delivery-Context.yaml
        Detected format  : OSI Semantic Model (Format A), version 1.0
        Excluded datasets: none (no load_audit dataset present)
        Icon choices     : CustomerAddress 📍 (location), Restaurant 🏢 (organization),
                           RestaurantCategory 📂 (known ProductCategory mapping applied),
                           RestaurantCategoryMap 📄 (mapping/document),
                           MenuSection 📄 (document/section), MenuItem 📦 (product),
                           OperatingHour 📅 (event/schedule), OrderPromotion 💰 (finance),
                           Promotion 💰 (finance - next unused color),
                           Delivery 🚚 (known Shipment mapping applied),
                           DeliveryAgent 👥 (group/agents), AgentPayout 💰 (finance),
                           Review 📊 (metrics/ratings), SupportTicket 🚨 (safety/issue)
        Classes          : 18 | Data properties: 148 | Measure properties: 27 | Object properties: 50 | Data bindings: 18
    -->


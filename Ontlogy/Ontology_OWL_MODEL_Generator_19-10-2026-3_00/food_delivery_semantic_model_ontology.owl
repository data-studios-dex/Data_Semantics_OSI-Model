    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/order_has_delivery">
        <rdfs:label>hasDelivery</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Delivery"/>
        <rdfs:comment>An order has at most one delivery record.</rdfs:comment>

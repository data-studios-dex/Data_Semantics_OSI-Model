        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>delivery</ont:toEntityId>
        <ont:joinKey>order_id=order_id</ont:joinKey>
        <ont:sourceRelationship>orders_to_deliveries</ont:sourceRelationship>

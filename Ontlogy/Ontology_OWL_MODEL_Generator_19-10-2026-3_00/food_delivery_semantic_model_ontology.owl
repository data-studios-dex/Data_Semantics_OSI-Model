        <rdfs:comment>A restaurant category can be referenced by multiple mapping entries.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/food-delivery-semantic-model/restaurantCategoryMap_belongs_to_restaurantCategory"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>restaurantCategory</ont:fromEntityId>
        <ont:toEntityId>restaurantCategoryMap</ont:toEntityId>
        <ont:joinKey>category_id=category_id</ont:joinKey>
        <ont:sourceRelationship>restaurant_category_map_to_restaurant_categories</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- restaurants_to_operating_hours: Restaurant -> OperatingHour (one-to-many; forward from OperatingHour) -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/operatingHour_belongs_to_restaurant">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>belongsTo</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/food-delivery-semantic-model/OperatingHour"/>
        <rdfs:range rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Restaurant"/>
        <rdfs:comment>An operating hours record belongs to exactly one restaurant.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/food-delivery-semantic-model/restaurant_has_operatingHour"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>operatingHour</ont:fromEntityId>
        <ont:toEntityId>restaurant</ont:toEntityId>
        <ont:joinKey>restaurant_id=restaurant_id</ont:joinKey>
        <ont:sourceRelationship>restaurants_to_operating_hours</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/restaurant_has_operatingHour">
        <rdfs:label>hasOperatingHour</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Restaurant"/>
        <rdfs:range rdf:resource="http://example.org/ontology/food-delivery-semantic-model/OperatingHour"/>
        <rdfs:comment>A restaurant has operating hours defined for each day of the week.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/food-delivery-semantic-model/operatingHour_belongs_to_restaurant"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>restaurant</ont:fromEntityId>
        <ont:toEntityId>operatingHour</ont:toEntityId>
        <ont:joinKey>restaurant_id=restaurant_id</ont:joinKey>
        <ont:sourceRelationship>restaurants_to_operating_hours</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- customers_to_customer_addresses: Customer -> CustomerAddress (one-to-many; forward from CustomerAddress) -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/customerAddress_belongs_to_customer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>belongsTo</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/food-delivery-semantic-model/CustomerAddress"/>
        <rdfs:range rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Customer"/>
        <rdfs:comment>A customer address belongs to exactly one customer.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/food-delivery-semantic-model/customer_has_customerAddress"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>customerAddress</ont:fromEntityId>
        <ont:toEntityId>customer</ont:toEntityId>
        <ont:joinKey>customer_id=customer_id</ont:joinKey>
        <ont:sourceRelationship>customers_to_customer_addresses</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/customer_has_customerAddress">
        <rdfs:label>hasCustomerAddress</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Customer"/>
        <rdfs:range rdf:resource="http://example.org/ontology/food-delivery-semantic-model/CustomerAddress"/>
        <rdfs:comment>A customer can have one or more delivery addresses.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/food-delivery-semantic-model/customerAddress_belongs_to_customer"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>customer</ont:fromEntityId>
        <ont:toEntityId>customerAddress</ont:toEntityId>
        <ont:joinKey>customer_id=customer_id</ont:joinKey>
        <ont:sourceRelationship>customers_to_customer_addresses</ont:sourceRelationship>
    </owl:ObjectProperty>


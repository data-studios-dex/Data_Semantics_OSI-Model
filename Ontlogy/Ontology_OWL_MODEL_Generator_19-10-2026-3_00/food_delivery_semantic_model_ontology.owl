        <rdfs:label>contains</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/food-delivery-semantic-model/OrderItem"/>
        <rdfs:comment>An order contains one or more order items.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/food-delivery-semantic-model/orderItem_belongs_to_order"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>orderItem</ont:toEntityId>
        <ont:joinKey>order_id=order_id</ont:joinKey>
        <ont:sourceRelationship>orders_to_order_items</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- order_items_to_menu_items: OrderItem -> MenuItem (many-to-one) -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/orderItem_refers_to_menuItem">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>refersTo</rdfs:label>

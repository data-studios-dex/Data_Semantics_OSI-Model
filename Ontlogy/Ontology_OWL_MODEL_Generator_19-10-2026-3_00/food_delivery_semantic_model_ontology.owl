    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/OperatingHour">
        <rdfs:label>OperatingHour</rdfs:label>
        <skos:prefLabel>Operating Hours</skos:prefLabel>
        <rdfs:comment>A record defining the opening and closing times for a restaurant on a specific day of the week.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>
        <ont:icon>🏭</ont:icon>
        <ont:iconCode>U+1F3ED</ont:iconCode>
        <ont:color>#E3008C</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/Order">
        <rdfs:label>Order</rdfs:label>
        <skos:prefLabel>Orders</skos:prefLabel>
        <rdfs:comment>A customer purchase transaction capturing order totals, fees, taxes, tips, status, and timestamps.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>
        <ont:icon>🧾</ont:icon>
        <ont:iconCode>U+1F9FE</ont:iconCode>
        <ont:color>#008272</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/OrderItem">
        <rdfs:label>OrderItem</rdfs:label>
        <skos:prefLabel>Order Items</skos:prefLabel>
        <rdfs:comment>A single line item within a customer order, referencing a menu item with quantity and pricing details.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>
        <ont:icon>🛒</ont:icon>
        <ont:iconCode>U+1F6D2</ont:iconCode>
        <ont:color>#4F6BED</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/Promotion">
        <rdfs:label>Promotion</rdfs:label>
        <skos:prefLabel>Promotions</skos:prefLabel>
        <rdfs:comment>A discount offer with eligibility rules, validity dates, and usage limits available to customers.</rdfs:comment>

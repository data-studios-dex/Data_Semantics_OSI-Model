        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/CustomerAddress">
        <rdfs:label>CustomerAddress</rdfs:label>
        <skos:prefLabel>Customer Addresses</skos:prefLabel>
        <rdfs:comment>A delivery address associated with a customer, capturing street, city, state, and geographic coordinates.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>
        <ont:icon>📍</ont:icon>
        <ont:iconCode>U+1F4CD</ont:iconCode>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/Restaurant">
        <rdfs:label>Restaurant</rdfs:label>
        <skos:prefLabel>Restaurants</skos:prefLabel>
        <rdfs:comment>A food service establishment registered on the platform that prepares and fulfills customer orders.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>
        <ont:icon>🏢</ont:icon>
        <ont:iconCode>U+1F3E2</ont:iconCode>
        <ont:color>#00B7C3</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/RestaurantCategory">
        <rdfs:label>RestaurantCategory</rdfs:label>
        <skos:prefLabel>Restaurant Categories</skos:prefLabel>
        <rdfs:comment>A classification label that groups restaurants by cuisine type or service style.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>
        <ont:icon>📂</ont:icon>
        <ont:iconCode>U+1F4C2</ont:iconCode>
        <ont:color>#5C2D91</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/RestaurantCategoryMap">
        <rdfs:label>RestaurantCategoryMap</rdfs:label>
        <skos:prefLabel>Restaurant Category Map</skos:prefLabel>
        <rdfs:comment>A many-to-many mapping record that assigns a restaurant to a specific category.</rdfs:comment>

        <rdfs:range rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Order"/>
        <rdfs:comment>A delivery is associated with exactly one order.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/food-delivery-semantic-model/order_has_delivery"/>
        <ont:cardinality>one-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>delivery</ont:fromEntityId>
        <ont:toEntityId>order</ont:toEntityId>

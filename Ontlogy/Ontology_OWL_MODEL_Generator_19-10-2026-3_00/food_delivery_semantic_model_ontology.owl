    <!-- deliveries_to_delivery_agents: Delivery -> DeliveryAgent (many-to-one) -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/delivery_belongs_to_deliveryAgent">

    <!-- orders_to_deliveries: one-to-one; forward from Delivery (many side treated as one-to-one) -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/delivery_belongs_to_order">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>

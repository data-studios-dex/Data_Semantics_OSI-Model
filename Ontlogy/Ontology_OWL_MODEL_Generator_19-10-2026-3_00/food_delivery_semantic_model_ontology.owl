    <!-- deliveries_to_agent_payouts: one-to-one -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/agentPayout_belongs_to_delivery">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>

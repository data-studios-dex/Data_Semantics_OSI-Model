        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>menuItem</ont:fromEntityId>
        <ont:toEntityId>orderItem</ont:toEntityId>
        <ont:joinKey>item_id=item_id</ont:joinKey>
        <ont:sourceRelationship>order_items_to_menu_items</ont:sourceRelationship>

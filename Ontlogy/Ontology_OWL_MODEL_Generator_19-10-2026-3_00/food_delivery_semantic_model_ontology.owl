    <owl:Class rdf:about="http://example.org/ontology/food-delivery-semantic-model/Customer">
        <rdfs:label>Customer</rdfs:label>
        <skos:prefLabel>Customers</skos:prefLabel>
        <rdfs:comment>A registered user of the food delivery platform who places orders and receives deliveries.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://example.org/ontology/food-delivery-semantic-model/"/>

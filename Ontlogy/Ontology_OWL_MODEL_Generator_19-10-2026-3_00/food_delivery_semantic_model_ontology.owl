        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp recording when the support ticket was created.</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/supportTicket_resolvedAt">
        <rdfs:label>resolvedAt</rdfs:label>
        <skos:prefLabel>Resolved At</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/food-delivery-semantic-model/SupportTicket"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Timestamp recording when the support ticket was resolved.</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/supportTicket_resolutionNotes">
        <rdfs:label>resolutionNotes</rdfs:label>
        <skos:prefLabel>Resolution Notes</skos:prefLabel>
        <rdfs:domain rdf:resource="http://example.org/ontology/food-delivery-semantic-model/SupportTicket"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Notes entered by support staff describing how the ticket was resolved.</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- ============================================================
         OBJECT PROPERTIES (RELATIONSHIPS)
         ============================================================ -->

    <!-- orders_to_customers: Order -> Customer (many-to-one) -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/order_placed_by_customer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>placedBy</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Customer"/>
        <rdfs:comment>An order is placed by exactly one customer.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/food-delivery-semantic-model/customer_places_order"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>customer</ont:toEntityId>
        <ont:joinKey>customer_id=customer_id</ont:joinKey>
        <ont:sourceRelationship>orders_to_customers</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/customer_places_order">
        <rdfs:label>places</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Customer"/>
        <rdfs:range rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Order"/>
        <rdfs:comment>A customer places one or more orders.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/food-delivery-semantic-model/order_placed_by_customer"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>customer</ont:fromEntityId>
        <ont:toEntityId>order</ont:toEntityId>
        <ont:joinKey>customer_id=customer_id</ont:joinKey>
        <ont:sourceRelationship>orders_to_customers</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- orders_to_restaurants: Order -> Restaurant (many-to-one) -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/order_belongs_to_restaurant">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>belongsTo</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Restaurant"/>
        <rdfs:comment>An order is fulfilled by exactly one restaurant.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://example.org/ontology/food-delivery-semantic-model/restaurant_has_order"/>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:cardinalitySource>declared</ont:cardinalitySource>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>restaurant</ont:toEntityId>
        <ont:joinKey>restaurant_id=restaurant_id</ont:joinKey>
        <ont:sourceRelationship>orders_to_restaurants</ont:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/restaurant_has_order">
        <rdfs:label>hasOrder</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Restaurant"/>
        <rdfs:range rdf:resource="http://example.org/ontology/food-delivery-semantic-model/Order"/>

        <ont:fromEntityId>restaurant</ont:fromEntityId>
        <ont:toEntityId>order</ont:toEntityId>
        <ont:joinKey>restaurant_id=restaurant_id</ont:joinKey>
        <ont:sourceRelationship>orders_to_restaurants</ont:sourceRelationship>
    </owl:ObjectProperty>

    <!-- orders_to_order_items: Order -> OrderItem (one-to-many; forward is from many side = OrderItem) -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/orderItem_belongs_to_order">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>belongsTo</rdfs:label>

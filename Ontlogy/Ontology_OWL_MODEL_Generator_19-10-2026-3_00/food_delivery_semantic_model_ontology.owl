    <owl:ObjectProperty rdf:about="http://example.org/ontology/food-delivery-semantic-model/deliveryAgent_has_delivery">
        <rdfs:label>hasDelivery</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/food-delivery-semantic-model/DeliveryAgent"/>
